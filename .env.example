# Flask session secret (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-in-production

# Fernet key for encrypting backend credentials in the database
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Password for the initial admin user (required on first boot)
# Accepts plaintext (hashed automatically) or a pre-hashed bcrypt string ($2b$/$2a$/$2y$)
# Examples:
#   ADMIN_PASSWORD=my-secret-password
#   ADMIN_PASSWORD=$2b$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Generate a bcrypt hash with: python3 getpwd.py
ADMIN_PASSWORD=

# Optional: pre-shared TOTP secret for admin 2FA
# Generate with: python3 -c "import pyotp; print(pyotp.random_base32())"
#ADMIN_TOTP_SECRET=

# Debug logging (set to DEBUG to enable)
#DEBUG=DEBUG

# Traefik reverse proxy
TRAEFIK_HOSTNAME=dyndns.example.com
LETSENCRYPT_EMAIL=admin@example.com
# Staging: https://acme-staging-v02.api.letsencrypt.org/directory
# Production: https://acme-v02.api.letsencrypt.org/directory
LETSENCRYPT_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# External ports (defaults: 80/443)
#HTTP_PORT=80
#HTTPS_PORT=443

# --- Legacy env-based auth (for backward compatibility / migration) ---
# These are used as fallback if no DB credentials are configured.
# After running migrate_env.py, these can be removed.
#USERNAME=myuser
#PASSWORD=$2b$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#DOMAINS=dyn.example.com,example.org
#AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
#AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#NSUPDATE_KEY=key.dyn.example.com
#NSUPDATE_ALGO=hmac-sha512
#NSUPDATE_SECRET=base64-encoded-secret-here
#NSUPDATE_NAMESERVER=10.0.0.1

# --- Loki logging (optional, docker-compose.override.yml only) ---
# Only needed if you enable log shipping via a local docker-compose.override.yml
# (see docker-compose.override.yml.example). The tracked compose files do not
# reference this, so leaving it unset is fine.
# Must be the full PUSH endpoint -- a bare base URL 404s silently.
# Install the driver first: docker plugin install grafana/loki-docker-driver:latest --alias loki --grant-all-permissions
#LOKI_URL=https://loki.example.com:3100/loki/api/v1/push
