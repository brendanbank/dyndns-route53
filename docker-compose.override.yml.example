# Local, site-specific Compose overrides.
#
# Docker Compose merges docker-compose.override.yml automatically on top of
# compose.yaml, and it takes PRECEDENCE per option key. The real file is
# gitignored, so anything site-specific (log shipping, alternate ports,
# internal endpoints) belongs here rather than in the public compose.yaml.
#
# Usage:
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   echo 'LOKI_URL=https://loki.example.com:3100/loki/api/v1/push' >> .env
#   docker compose up -d
#
# Requires the Loki log driver plugin on the Docker host:
#   docker plugin install grafana/loki-docker-driver:latest --alias loki --grant-all-permissions
#
# NOTE: loki-url must be the full PUSH endpoint, ending in /loki/api/v1/push.
# A bare base URL silently 404s and no logs are stored. Verify with:
#   curl -o /dev/null -w '%{http_code}\n' -XPOST -d '{}' "$LOKI_URL"
#   -> 4xx other than 404 means the endpoint exists; 404 means wrong path.
#
# Because the override REPLACES the whole option key, a partial copy of this
# file silently drops whatever it omits.

services:
  traefik:
    logging:
      driver: "loki"
      options:
        max-size: "500m"
        max-file: "1"
        # container={{.Name}} is required, not decorative. The driver applies
        # its container_name={{.Name}} default ONLY when loki-external-labels
        # is unset, so setting this option at all silently drops it.
        loki-external-labels: "platform=docker,app=dyndns,container={{.Name}}"
        loki-url: "${LOKI_URL}"

        # Pipeline stages for Traefik's JSON access log (--accesslog.format=json,
        # enabled in compose.yaml).
        #
        # Credentials cannot reach these logs: Traefik strips all query
        # parameters at the producer via
        # --accesslog.fields.queryparameters.defaultmode=drop (see compose.yaml).
        #
        # There is deliberately NO `replace` redaction stage here. One was tried
        # and is not trustworthy: it redacts correctly in every isolated test of
        # this exact config, yet still leaked a canary password on the live
        # long-running traefik container, with no error logged anywhere. Do not
        # reintroduce it as a security control.
        loki-pipeline-stages: |
          - json:
              expressions:
                level: level
                status: DownstreamStatus
                router: RouterName
                service: ServiceName
                entrypoint: entryPointName
          - labels:
              level:
              status:
              router:
              entrypoint:

        # Only low-cardinality fields are promoted to labels above. RequestPath
        # and ClientHost stay in the log line on purpose -- as labels they would
        # create a new Loki stream per unique value.
        #
        # There is deliberately no loki-relabel-config here. Every rule that
        # used to live in one was a no-op, verified against a live Loki:
        #   host -> host             identity copy of a label the driver emits
        #   container_name -> container   source label never exists (see above)
        #   stream -> stream         the driver's label is called `source`
        #   __filename__ -> job      promtail-internal; driver passes `filename`
        # Query with source="stdout"|"stderr" where you would have used stream.

  web:
    logging:
      driver: "loki"
      options:
        max-size: "500m"
        max-file: "1"
        # container={{.Name}} is required, not decorative. The driver applies
        # its container_name={{.Name}} default ONLY when loki-external-labels
        # is unset, so setting this option at all silently drops it.
        loki-external-labels: "platform=docker,app=dyndns,container={{.Name}}"
        loki-url: "${LOKI_URL}"

        # This service logs PLAIN TEXT, not JSON (see lib/log.py, which sets
        # format='%(asctime)s %(funcName)s(%(lineno)s): %(message)s'). Do NOT
        # copy the traefik json stage here -- it would error on every line.
        # The multiline stage buffers Python tracebacks into single entries.
        #
        # No redaction stage is needed: gunicorn's access log is disabled
        # entirely (see Dockerfile) and the app logs no URLs, so request paths
        # never reach these logs. Traefik is the only place a path is logged.
        loki-pipeline-stages: |
          - multiline:
              firstline: '^Traceback \(most recent call last\):'
              max_wait_time: 3s
              max_lines: 128

